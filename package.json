{
  "name": "virtual-gallery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepare:room-a": "node scripts/prepare-stage1.mjs",
    "generate:room-a-lightmaps": "node scripts/generate-room-a-lightmaps.mjs",
    "prepare:room-b": "node scripts/prepare-room-b.mjs",
    "prepare:room-c": "node scripts/prepare-room-c.mjs",
    "validate:room-a": "node scripts/validate-stage1.mjs && node --test scripts/room-a-layout.test.mjs scripts/mobile-render-quality.test.mjs",
    "validate:room-b": "node scripts/validate-room-b.mjs && node --test scripts/room-b-layout.test.mjs",
    "validate:room-c": "node scripts/validate-room-c.mjs && node --test scripts/room-c-layout.test.mjs",
    "test:layout": "node --test scripts/room-a-layout.test.mjs",
    "test:render-quality": "node --test scripts/mobile-render-quality.test.mjs",
    "prepare:stage1": "node scripts/prepare-stage1.mjs",
    "validate:stage1": "node scripts/validate-stage1.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "@vitejs/plugin-react": "latest",
    "sharp": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
